	УстановитьЗначениеXDTO(Контент, "DocumentNumber",					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Номер"));
	УстановитьЗначениеXDTO(Контент, "DocumentDate",						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "Дата"));


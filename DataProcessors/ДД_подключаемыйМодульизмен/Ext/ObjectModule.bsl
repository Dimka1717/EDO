	Реквизиты.Номер	= СокрЛП(РеквизитыДокументаУчета.Номер);
	Реквизиты.Дата	= РеквизитыДокументаУчета.Дата;
	Реквизиты.Сумма	= РеквизитыДокументаУчета.СуммаДокумента;
	
	Возврат Истина;
	
КонецФункции



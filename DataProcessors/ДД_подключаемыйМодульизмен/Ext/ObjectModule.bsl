// Создание документа по данным из Диадока
Функция ПолучитьЗаполненныйОбъектДокумента1С(Параметры)
	
	//http://1c-pro-docs.diadoc.ru/ru/latest/func/pm/Poluchit'_Zapolnennyy_Obyekt_Dokumenta_1S.html
	
	Ошибки = Новый Массив;
	
	ПроверитьФункциюДокумента(Параметры, Ошибки);
	ПроверитьЗаполнитьИдентификаторОперации(Параметры, Ошибки);
	ПроверитьЗаполнитьДокументОснование(Параметры, Ошибки);
	
	Если ЗначениеЗаполнено(Ошибки) Тогда
		Результат = РезультатФункцииОшибка(Ошибки);
		Возврат Результат;
	КонецЕсли;
	
	ТиповойМодуль = ТиповойМодульДиадока();
	
	Результат = ОсновнойМодуль.ТиповойМодуль_СоздатьДокумент(ТиповойМодуль, Параметры);
	
	НовыйОбъект = Результат.ОсновнойОбъект;
	Ошибки = ЗначениеВМассив(Результат.ОписаниеОшибки);
	
	ПроверитьЗаполнениеДокумента(НовыйОбъект, Ошибки);
	
	Если Не ЗначениеЗаполнено(Ошибки) Тогда 
		
		Если Параметры.СоздаватьСчетаФактуры
			И ТребуетсяСоздатьСчетФактуру(НовыйОбъект) Тогда
			
			СоздатьСчетФактуру(НовыйОбъект, Параметры.Документ);
			
		КонецЕсли; 
		
	Иначе
		
		Результат.ОсновнойОбъект = Неопределено;
		Результат.ОписаниеОшибки = ОсновнойМодуль.ЭДО_Служебные_МассивВСтроку(Ошибки, Символы.ПС);
		
	КонецЕсли;
	
	
	Возврат Результат;
	
КонецФункции

// Заполняет в таблице сопоставления колонки со сведениями о номенклатуре информационной базы:
// * Номенклатура
// * Характеристика
// * Упаковка
//
// Параметры:
//  ПараметрыПМ - Структура - параметры события:
//    * ТаблицаСопоставления - ТаблицаЗначений - таблица сопоставления номенклатуры (см. НоваяТаблицаНоменклатурыДляСопоставления).
//
Функция ПрочитатьСопоставлениеНоменклатуры(ПараметрыПМ)
	
	Результат = ОсновнойМодуль.НовыйРезультатФункции();
	
	ТиповойМодуль = ТиповойМодульДиадока();
	ТаблицаНоменклатурыДляСопоставления = ПараметрыПМ.ТаблицаСопоставления;
	
	ОсновнойМодуль.ТиповойМодуль_ПрочитатьСопоставлениеНоменклатуры(ТаблицаНоменклатурыДляСопоставления, ТиповойМодуль);
	
	Возврат Результат;
	
КонецФункции

